
import streamlit as st
import joblib
import re

# Setting the page details
st.set_page_config(
    page_title="Movie Genre Predictor",
    page_icon="🎬",
    layout="centered"
)

# Loading the saved machine learning model
@st.cache_resource
def load_model():
    return joblib.load("movie_genre_prediction_model.joblib")

try:
    model_data = load_model()

    model = model_data['model']
    tfidf = model_data['tfidf']
    genre_classes = model_data['genre_classes']
    model_name = model_data['model_name']

except Exception as e:
    st.error("Model could not be loaded. Check the model file.")
    st.stop()


# Function to clean the movie description
def clean_text(text):

    text = text.lower()
    text = re.sub(r'[^a-z\s]', ' ', text)
    text = re.sub(r'\s+', ' ', text)

    return text.strip()


# Application heading
st.title("🎬 Movie Genre Prediction")

st.write(
    "Enter a movie description and the machine learning "
    "model will predict its possible genres."
)

st.divider()

# Taking movie description from the user
movie_description = st.text_area(
    "Enter Movie Description",
    placeholder="Example: A young boy discovers magical powers..."
)

# Predict button
if st.button("Predict Movie Genre"):

    if movie_description.strip() == "":
        st.warning("Please enter a movie description.")

    else:

        # Cleaning the input description
        cleaned_description = clean_text(movie_description)

        # Converting text into TF-IDF features
        movie_features = tfidf.transform([cleaned_description])

        # Predicting the genres
        prediction = model.predict(movie_features)

        # Converting prediction into genre names
        predicted_genres = [
            genre_classes[i]
            for i, value in enumerate(prediction[0])
            if value == 1
        ]

        st.subheader("Prediction Result")

        if predicted_genres:

            for genre in predicted_genres:
                st.success("🎬 " + str(genre))

        else:
            st.info("No genre was predicted for this description.")

st.divider()

st.caption("Machine Learning Model: " + str(model_name))
st.caption("Project: Movie Genre Prediction")
